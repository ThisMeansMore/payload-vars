{
  "name": "payload-vars",
  "version": "1.2.1",
  "description": "Typed variables in JSON payload templates",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThisMeansMore/payload-vars.git"
  },
  "bugs": {
    "url": "https://github.com/ThisMeansMore/payload-vars/issues"
  },
  "homepage": "https://github.com/ThisMeansMore/payload-vars#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG-ARCHIVE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "docs:sync": "node scripts/build.mjs --docs",
    "typecheck": "npm run build && npm run test:types",
    "test": "npm run build && npm run test:types && node --test test/*.spec.js",
    "prepack": "npm run build",
    "test:types": "tsc -p test/types/tsconfig.json",
    "prepublishOnly": "node scripts/publish-version.mjs --check",
    "prepare-version": "node scripts/prepare-version.mjs",
    "publish-version": "node scripts/publish-version.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "keywords": [
    "json",
    "template",
    "variables",
    "typescript"
  ]
}
